{
  "name": "AMBS Email Signature Builder",
  "short_name": "AMBS Signature",
  "description": "Make and copy email signatures for Gmail, Outlook and Apple Mail.",
  "id": "/email-signature",
  "start_url": "/email-signature",
  "scope": "/email-signature",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#ffffff",
  "background_color": "#eef1f7",
  "icons": [
    { "src": "/icon-192-v4.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512-v4.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192-maskable-v4.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512-maskable-v4.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
