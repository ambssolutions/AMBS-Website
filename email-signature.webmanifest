{
  "name": "AMBS Email Signature Builder",
  "short_name": "AMBS Signature",
  "description": "Make and copy email signatures for Gmail, Outlook and Apple Mail.",
  "id": "/email-signature",
  "start_url": "/email-signature",
  "scope": "/email-signature",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#ffffff",
  "background_color": "#eef1f7",
  "icons": [
    {
      "src": "/sig-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sig-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sig-icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/sig-icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
